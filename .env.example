# VoiceGuard / SIH26104 Environment Configuration
# Strict CPU-Only Execution by Default

DEVICE=cpu
MODEL_MODE=real
DEMO_MODE=false
SAMPLE_RATE=16000
MIN_AUDIO_DURATION=2.0
MAX_AUDIO_DURATION=30.0
MAX_FILE_SIZE_MB=15
DATABASE_URL=sqlite:///./sih26104.db

# Risk Engine Weights
VOICE_WEIGHT=0.60
CONTEXT_WEIGHT=0.30
FRAUD_WEIGHT=0.10

# Decision Policy Thresholds
APPROVE_THRESHOLD=30
CHALLENGE_THRESHOLD=65

# Server Ports
PORT=8000
FRONTEND_PORT=8501
